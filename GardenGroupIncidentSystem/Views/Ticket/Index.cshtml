@model List<GardenGroupIncidentSystem.Models.Ticket>
@using GardenGroupIncidentSystem.Models
@{
    ViewData["Title"] = "Tickets";
    var tickets = ViewData["tickets"] as List<GardenGroupIncidentSystem.Models.Employee>;
}

<!DOCTYPE html>
<html>
<head>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px;
        }

        .container {
            max-width: 1500px;
            margin: 0 auto;
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 36px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .header h1 {
                font-size: 30px;
                font-weight: 600;
            }

        .stats {
            display: flex;
            gap: 16px;
        }

        .stat-card {
            background: rgba(255,255,255,0.2);
            padding: 12px 18px;
            border-radius: 10px;
            text-align: center;
        }

        .stat-number {
            font-size: 22px;
            font-weight: 700;
        }

        .stat-label {
            font-size: 12px;
            opacity: 0.95;
        }

        .content {
            padding: 30px 40px;
        }

        .alert {
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 2px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 2px solid #f5c6cb;
        }

        .actions-bar {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .search-box {
            display: flex;
            gap: 10px;
            flex: 1;
            min-width: 520px;
        }

            .search-box input, .search-box select {
                padding: 12px 16px;
                border: 2px solid #e0e0e0;
                border-radius: 8px;
                font-size: 14px;
            }

            .search-box input {
                flex: 1;
            }

        .btn {
            padding: 12px 22px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all .2s;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102,126,234,.4);
            }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-info {
            background: #17a2b8;
            color: white;
            padding: 8px 14px;
            font-size: 12px;
        }

        .btn-warning {
            background: #ffc107;
            color: #212529;
            padding: 8px 14px;
            font-size: 12px;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
            padding: 8px 14px;
            font-size: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }

        thead {
            background: #f8f9fa;
        }

        th {
            padding: 14px;
            text-align: left;
            font-weight: 700;
            color: #495057;
            border-bottom: 2px solid #dee2e6;
            font-size: 13px;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #e9ecef;
            font-size: 14px;
            vertical-align: top;
        }

        tbody tr:hover {
            background: #f8f9fa;
        }

        .badge {
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            display: inline-block;
            white-space: nowrap;
        }

        .b-pri-high {
            background: #ffebee;
            color: #c62828;
        }

        .b-pri-med {
            background: #fff8e1;
            color: #ef6c00;
        }

        .b-pri-low {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .b-status-open {
            background: #e3f2fd;
            color: #1565c0;
        }

        .b-status-closed {
            background: #eceff1;
            color: #546e7a;
        }

        .b-status-resolved {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .assignees {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .assignee-chip {
            background: #ede7f6;
            color: #4a148c;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }

        .muted {
            color: #6c757d;
        }

        .cell-mono {
            font-family: Consolas, 'Courier New', monospace;
            font-size: 12px;
            color: #495057;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div>
                <h1>🎫 Tickets</h1>
                <p style="margin-top:8px;opacity:.95;">Index — list, search & filter</p>
            </div>
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.TotalTickets</div>
                    <div class="stat-label">Total</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.OpenCount</div>
                    <div class="stat-label">Open</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.ResolvedCount</div>
                    <div class="stat-label">Resolved</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">@ViewBag.ClosedCount</div>
                    <div class="stat-label">Closed</div>
                </div>
            </div>
        </div>

        <div class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">❌ @TempData["Error"]</div>
            }

            <div class="actions-bar">
                <!-- Search & Filters -->
                <form method="get" asp-action="Index" class="search-box">
                    <input type="text" name="q" value="@ViewBag.Query" placeholder="🔎 Search by Ticket ID, subject, description…">
                    <select name="status">
                        <option value="all" selected="@(ViewBag.StatusFilter == "all")">All Statuses</option>
                        <option value="Open" selected="@(ViewBag.StatusFilter == "Open")">Open</option>
                        <option value="Resolved" selected="@(ViewBag.StatusFilter == "Resolved")">Resolved</option>
                        <option value="Closed" selected="@(ViewBag.StatusFilter == "Closed")">Closed</option>
                    </select>
                    <select name="priority">
                        <option value="all" selected="@(ViewBag.PriorityFilter == "all")">All Priorities</option>
                        <option value="High" selected="@(ViewBag.PriorityFilter == "High")">High</option>
                        <option value="Medium" selected="@(ViewBag.PriorityFilter == "Medium")">Medium</option>
                        <option value="Low" selected="@(ViewBag.PriorityFilter == "Low")">Low</option>
                    </select>
                    <select name="type">
                        <option value="all" selected="@(ViewBag.TypeFilter == "all")">All Types</option>
                        <option value="Access Request" selected="@(ViewBag.TypeFilter == "Access Request")">Access Request</option>
                        <option value="Hardware Request" selected="@(ViewBag.TypeFilter == "Hardware Request")">Hardware Request</option>
                        <option value="Incident" selected="@(ViewBag.TypeFilter == "Incident")">Incident</option>
                        <option value="Other" selected="@(ViewBag.TypeFilter == "Other")">Other</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Filter</button>
                </form>

                <div style="display:flex; gap:10px;">
                    <a class="btn btn-secondary" href="@Url.Action("Index","Ticket")">Clear</a>
                    <a class="btn btn-primary" href="@Url.Action("Create","Ticket")">➕ Create Ticket</a>
                </div>
            </div>

            <!-- Tickets table -->
            <table>
                <thead>
                    <tr>
                        <th>Ticket</th>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Reported</th>
                        <th>Deadline</th>
                        <th>Active Assignees</th>
                        <th>Reporter</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="10" style="text-align:center; padding:36px;" class="muted">
                                No tickets found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            string priClass = t.Priority?.ToLowerInvariant() switch
                            {
                                "high" => "b-pri-high",
                                "medium" => "b-pri-med",
                                "low" => "b-pri-low",
                                _ => "b-pri-med"
                            };

                            string statusClass = t.TicketStatus switch
                            {
                                Status.Open => "b-status-open",
                                Status.Resolved => "b-status-resolved",
                                Status.Closed => "b-status-closed",
                                _ => "b-status-open"
                            };

                            var activeWorkers = (t.WorkedBy ?? new List<WorkedBy>())
                            .Where(wb => wb != null && wb.Active)
                            .ToList();

                            <tr>
                                <td><strong>@t.Id</strong></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(t.Subject))
                                    {
                                        @t.Subject
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                    <div class="cell-mono" title="@t.Description">@((t.Description ?? "").Length > 90 ? (t.Description.Substring(0, 90) + "…") : t.Description)</div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(t.Type) ? Html.Raw("<span class='muted'>—</span>") : Html.Raw(t.Type))</td>
                                <td><span class="badge @priClass">@t.Priority</span></td>
                                <td><span class="badge @statusClass">@t.TicketStatus</span></td>
                                <td>
                                    @t.DateTimeReport.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    @t.Deadline.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    @if (activeWorkers.Count == 0)
                                    {
                                        <span class="muted">No active assignee</span>
                                    }
                                    else
                                    {
                                        <div class="assignees">
                                            @foreach (var wb in activeWorkers)
                                            {
                                                var name = wb.Employee?.Name != null
                                                ? $"{wb.Employee.Name.FirstName} {wb.Employee.Name.LastName}"
                                                : (wb.Employee?.Id ?? "Employee");
                                                <span class="assignee-chip">@name</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="cell-mono">@t.EmployeeID</td>
                                <td style="white-space:nowrap;">
                                    <a href="@Url.Action("Details","Ticket", new { id = t.Id })" class="btn btn-info">👁️ Details</a>

                                    @if (User.IsInRole("supervisor"))
                                    {
                                        <a href="@Url.Action("Edit","Ticket", new { id = t.Id })" class="btn btn-warning">✏️ Edit</a>
                                        <form asp-action="Delete" asp-controller="Ticket" method="post" style="display:inline" onsubmit="return confirm('Delete ticket @t.Id?');">
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button type="submit" class="btn btn-danger">🗑️ Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            @* Optional: simple pager placeholders if you add paging in the controller
        <div style="margin-top:16px; display:flex; gap:10px; justify-content:flex-end;">
            <a class="btn btn-secondary" href="@Url.Action("Index", new { page = ViewBag.PrevPage, q = ViewBag.Query, status = ViewBag.StatusFilter, priority = ViewBag.PriorityFilter, type = ViewBag.TypeFilter })">Prev</a>
            <a class="btn btn-secondary" href="@Url.Action("Index", new { page = ViewBag.NextPage, q = ViewBag.Query, status = ViewBag.StatusFilter, priority = ViewBag.PriorityFilter, type = ViewBag.TypeFilter })">Next</a>
        </div>
        *@
        </div>
    </div>
</body>
</html>