@model GardenGroupIncidentSystem.Models.Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); padding:20px; }
        .container { max-width: 800px; margin: 0 auto; background:#fff; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.3); overflow:hidden; }
        .header { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:#fff; padding:26px 32px; }
        .header h1 { font-size:24px; font-weight:600; }
        .content { padding:32px; }
        .warning { background:#fff3cd; color:#7c5b00; border:2px solid #ffeeba; padding:16px; border-radius:8px; margin-bottom:18px; }
        .details { background:#f8f9fa; border:2px solid #e9ecef; border-radius:8px; padding:16px; margin-bottom:16px; }
        .row { margin:6px 0; }
        .label { color:#6c757d; display:inline-block; min-width:140px; }
        .btn { padding:12px 22px; border:none; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; text-decoration:none; display:inline-block; }
        .btn-danger { background:#dc3545; color:#fff; }
        .btn-secondary { background:#6c757d; color:#fff; }
        .actions { display:flex; gap:10px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🗑️ Delete Employee — @Model.Id</h1>
        </div>
        <div class="content">
            <div class="warning">
                <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this employee?
            </div>

            <div class="details">
                <div class="row"><span class="label">Employee ID</span><strong>@Model.Id</strong></div>
                <div class="row"><span class="label">Name</span>@Model.Name?.FirstName @Model.Name?.LastName</div>
                <div class="row"><span class="label">Email</span>@Model.ContactDetails?.EmailAddress</div>
                <div class="row"><span class="label">Phone</span>@Model.ContactDetails?.PhoneNumber</div>
                <div class="row"><span class="label">Location</span>@Model.ContactDetails?.Location</div>
                <div class="row"><span class="label">Role</span>@Model.EmployeeRole.ToString().Replace("_", " ")</div>
            </div>

            <form asp-action="DeleteConfirmed" method="post" class="actions">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Yes, delete</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>
