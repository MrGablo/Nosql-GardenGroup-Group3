@model GardenGroupIncidentSystem.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
}

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); padding:20px; }
        .container { max-width: 900px; margin: 0 auto; background: #fff; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.3); overflow:hidden; }
        .header { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:#fff; padding:28px 36px; }
        .header h1 { font-size:26px; font-weight:600; }
        .content { padding:36px; }
        .info-note { background:#e7f3ff; border-left:4px solid #2196f3; padding:12px 15px; border-radius:4px; font-size:14px; color:#0d47a1; margin-bottom:18px; }
        .form-grid { display:grid; grid-template-columns: repeat(2,1fr); gap:18px; margin-bottom:20px; }
        .form-group { display:flex; flex-direction:column; }
        .form-group label { font-weight:600; margin-bottom:6px; color:#495057; font-size:14px; }
        .form-group input, .form-group select { padding:12px; border:2px solid #ced4da; border-radius:6px; font-size:14px; }
        .btn { padding:12px 22px; border:none; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; text-decoration:none; display:inline-block; }
        .btn-primary { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:#fff; }
        .btn-secondary { background:#6c757d; color:#fff; }
        .actions { display:flex; gap:10px; margin-top:10px; }
        .muted { color:#6c757d; font-size:13px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✏️ Edit Employee — @Model.Id</h1>
        </div>
        <div class="content">

            @if (TempData["Error"] != null)
            {
                <div class="info-note" style="background:#f8d7da;border-left-color:#c82333;color:#721c24;">
                    ❌ @TempData["Error"]
                </div>
            }

            <div class="info-note">
                ℹ️ <strong>About Password Security:</strong> Passwords are hashed using SHA256 before storage.
                Leave “New Password” empty to keep the current password.
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="form-grid">
                    <div class="form-group">
                        <label>Employee ID</label>
                        <input value="@Model.Id" disabled />
                        <span class="muted">Id is not editable</span>
                    </div>

                    <div></div>

                    <div class="form-group">
                        <label>First Name</label>
                        <input name="firstName" value="@Model.Name?.FirstName" required />
                    </div>

                    <div class="form-group">
                        <label>Last Name</label>
                        <input name="lastName" value="@Model.Name?.LastName" required />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input name="email" type="email" value="@Model.ContactDetails?.EmailAddress" />
                    </div>

                    <div class="form-group">
                        <label>Phone</label>
                        <input name="phone" value="@Model.ContactDetails?.PhoneNumber" />
                    </div>

                    <div class="form-group">
                        <label>Location</label>
                        <input name="location" value="@Model.ContactDetails?.Location" />
                    </div>

                    <div class="form-group">
                        <label>Role</label>
                        <select name="role" required>
                            <option value="regular" selected="@(Model.EmployeeRole == GardenGroupIncidentSystem.Models.Role.regular)">Regular</option>
                            <option value="supervisor" selected="@(Model.EmployeeRole == GardenGroupIncidentSystem.Models.Role.supervisor)">Supervisor</option>
                            <option value="servicedesk_1" selected="@(Model.EmployeeRole == GardenGroupIncidentSystem.Models.Role.servicedesk_1)">Service Desk 1</option>
                            <option value="servicedesk_2" selected="@(Model.EmployeeRole == GardenGroupIncidentSystem.Models.Role.servicedesk_2)">Service Desk 2</option>
                            <option value="servicedesk_3" selected="@(Model.EmployeeRole == GardenGroupIncidentSystem.Models.Role.servicedesk_3)">Service Desk 3</option>
                        </select>
                    </div>

                    <div class="form-group" style="grid-column: 1 / span 2;">
                        <label>New Password (optional)</label>
                        <input name="newPassword" type="password" placeholder="Leave blank to keep current password" />
                    </div>
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn-primary">✅ Save Changes</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Details</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
